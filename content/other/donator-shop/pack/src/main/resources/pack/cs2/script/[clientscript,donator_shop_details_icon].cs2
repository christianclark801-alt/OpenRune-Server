[clientscript,donator_shop_details_icon](component $icon, obj $obj)
cc_deleteall($icon);
cc_create($icon, ^iftype_graphic, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
cc_setgraphicshadow(0x333333);
cc_setoutline(1);
cc_setobject_nonum($obj, 1);
