[clientscript,game_mode_card](component $card, int $x, int $width, obj $icon, string $title, string $desc)
if_setposition($x, 0, ^setpos_abs_left, ^setpos_abs_top, $card);
if_setsize($width, if_getheight($card), ^setsize_abs, ^setsize_abs, $card);
cc_deleteall($card);

cc_create($card, ^iftype_rectangle, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x5a4a2f);
cc_setfill(true);

cc_create($card, ^iftype_rectangle, 1);
cc_setposition(1, 1, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(2, 2, ^setsize_minus, ^setsize_minus);
cc_setcolour(0x2b2318);
cc_setfill(true);

cc_create($card, ^iftype_graphic, 2);
cc_setposition(0, 14, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
cc_setgraphicshadow(0x333333);
cc_setoutline(1);
cc_setobject_nonum($icon, 1);

cc_create($card, ^iftype_text, 3);
cc_setposition(0, 52, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(8, 32, ^setsize_minus, ^setsize_abs);
cc_settextfont(b12_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0xff981f);
cc_settext($title);

cc_create($card, ^iftype_text, 4);
cc_setposition(0, 88, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(12, 92, ^setsize_minus, ^setsize_abs);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
cc_settextshadow(true);
cc_setcolour(0xffffff);
cc_settext($desc);

cc_create($card, ^iftype_text, 5);
cc_setposition(0, 6, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setsize(8, 16, ^setsize_minus, ^setsize_abs);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0xffff00);
cc_settext("Select");

if_setonmouseover("game_mode_card_hover($card, 1)", $card);
if_setonmouseleave("game_mode_card_hover($card, 0)", $card);
