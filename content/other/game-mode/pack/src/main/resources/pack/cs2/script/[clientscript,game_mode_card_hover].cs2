[clientscript,game_mode_card_hover](component $card, int $hovered)
if (cc_find($card, 1) = true) {
    if ($hovered = 1) {
        cc_setcolour(0x3e3529);
    } else {
        cc_setcolour(0x2b2318);
    }
}
if (cc_find($card, 3) = true) {
    if ($hovered = 1) {
        cc_setcolour(0xffff00);
    } else {
        cc_setcolour(0xff981f);
    }
}
