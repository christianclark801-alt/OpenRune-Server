[[interface]]
name = "interface.boss_atlas"
width = 512
height = 334
on_load = ["clientscript.boss_atlas_init", "component.boss_atlas:border", "component.boss_atlas:searchbar", "component.boss_atlas:searchtext", "component.boss_atlas:list", "component.boss_atlas:panelbg", "component.boss_atlas:teleport", "component.boss_atlas:favbtn", "component.boss_atlas:dropsbtn", "component.boss_atlas:instbtn"]

[[component]]
name = "border"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "searchbar"
type = "layer"
x = 10
y = 40
width = 290
height = 22

[[component]]
name = "searchtext"
type = "text"
x = 10
y = 40
width = 290
height = 22
options = ["Search"]
text = "*"
font = "regular"
h_align = "center"
v_align = "center"
color = "#FF981F"

[[component]]
name = "tab0"
type = "layer"
x = 10
y = 66
width = 90
height = 20
options = ["View"]

[[component]]
name = "tab1"
type = "layer"
x = 10
y = 90
width = 90
height = 20
options = ["View"]

