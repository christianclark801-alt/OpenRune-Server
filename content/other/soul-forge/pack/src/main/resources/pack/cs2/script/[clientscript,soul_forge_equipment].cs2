[clientscript,soul_forge_equipment](component $layer, int $selected)
cc_deleteall($layer);
def_int $i = 0;
def_int $slot = 0;
def_obj $obj = null;
while ($i < 11) {
    $slot = ~soul_forge_worn_slot($i);
    cc_create($layer, ^iftype_graphic, $i);
    cc_setposition(calc(6 + $i * 44), 4, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    $obj = inv_getobj(worn, $slot);
    if ($obj ! null) {
        cc_setobject($obj, inv_getnum(worn, $slot));
        cc_setgraphicshadow(0x333333);
        if ($slot = $selected) {
            cc_setoutline(2);
        } else {
            cc_setoutline(1);
        }
        cc_setop(1, "Select");
        cc_setopbase("<col=ff9040><oc_name($obj)></col>");
    }
    $i = calc($i + 1);
}
