[[interface]]
name = "interface.soul_dice"
width = 512
height = 334
on_load = ["clientscript.soul_dice_init", "component.soul_dice:border", "component.soul_dice:dicebg", "component.soul_dice:roll", "component.soul_dice:die"]

[[component]]
name = "border"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "essence"
type = "text"
x = 10
y = 38
width = 492
height = 16
font = "bold"
h_align = "center"
v_align = "center"
text_shadow = true
color = "#FF981F"
text = "Soul Essence: 0"

[[component]]
name = "dicebg"
type = "layer"
x = 10
y = 56
width = 492
height = 86

[[component]]
