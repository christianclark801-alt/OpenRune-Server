[clientscript,admin_tool_button_hover](component $list, int $base, int $hovered)
if (cc_find($list, calc($base + 1)) = true) {
    if ($hovered = 1) {
        cc_setcolour(0x3e3529);
    } else {
        cc_setcolour(0x2b2318);
    }
}
if (cc_find($list, calc($base + 2)) = true) {
    if ($hovered = 1) {
        cc_setcolour(0xffff00);
    } else {
        cc_setcolour(0xff981f);
    }
}
