[clientscript,admin_tool_button](component $list, int $slot, int $x, int $y, int $width, int $height, string $label, string $hint)
def_int $base = calc($slot * 5);

cc_create($list, ^iftype_rectangle, $base);
cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($width, $height, ^setsize_abs, ^setsize_abs);
cc_setcolour(0x5a4a2f);
cc_setfill(true);

cc_create($list, ^iftype_rectangle, calc($base + 1));
cc_setposition(calc($x + 1), calc($y + 1), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($width - 2), calc($height - 2), ^setsize_abs, ^setsize_abs);
cc_setcolour(0x2b2318);
cc_setfill(true);

cc_create($list, ^iftype_text, calc($base + 2));
cc_setposition(calc($x + 4), calc($y + 2), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($width - 8), 16, ^setsize_abs, ^setsize_abs);
cc_settextfont(p12_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0xff981f);
cc_settext($label);

cc_create($list, ^iftype_text, calc($base + 3));
cc_setposition(calc($x + 4), calc($y + 17), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($width - 8), 12, ^setsize_abs, ^setsize_abs);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextshadow(true);
cc_setcolour(0x9f9f9f);
cc_settext($hint);

cc_create($list, ^iftype_layer, calc($base + 4));
cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($width, $height, ^setsize_abs, ^setsize_abs);
cc_setop(1, "Run");
cc_setopbase("<col=ff9040><$label></col>");
cc_setonmouseover("admin_tool_button_hover($list, $base, 1)");
cc_setonmouseleave("admin_tool_button_hover($list, $base, 0)");
